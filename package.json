{
  "name": "boxhead2play-js",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup:assets": "node tools/setup/ensureAssets.ts",
    "predev": "npm run setup:assets --silent",
    "dev": "vite",
    "prebuild": "npm run setup:assets --silent",
    "build": "tsc --noEmit && vite build && npm run build:server && npm run precompress",
    "precompress": "node tools/build/precompress.ts dist",
    "build:server": "vite build --ssr src/server/main.ts --outDir dist-server --emptyOutDir",
    "start": "node dist-server/main.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "extract": "node tools/extract/main.ts",
    "extract:debug": "node tools/extract/debug/composeRoomSvg.ts",
    "bandwidth": "node tools/dev/runInVite.ts tools/dev/bandwidth.ts",
    "monitor": "node tools/monitor/main.ts",
    "ci": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "fflate": "^0.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "typescript-language-server": "^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  }
}
